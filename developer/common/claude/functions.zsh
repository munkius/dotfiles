# nwt — launch a Claude Code worktree for a Linear issue, seeding
# `/start-work <KEY>` as the session's first prompt.
#
# The function itself is GENERATED by nia-playbook into ~/.nia/shell.sh on every
# `npm install` / `npm run playbook:upgrade`, so it always tracks the current
# repo layout. Do not paste a copy back here: the copy that used to live in this
# file hardcoded the consumer-only `scripts/playbook/nwt.mjs` path, so `nwt`
# failed inside the playbook repo itself — and because this file loads after
# ~/.localrc, the copy silently shadowed the generated function (NIA-1225).
#
#   nwt nia-123                    # worktree name derived from the Linear title
#   nwt nia-123 short custom slug  # explicit description override
#   nwt nia-123 fix timeout --perm bypass   # set the launch permission mode
#
# --perm <mode>: auto (default, no flag → repo settings) | bypass | plan | accept | default
[ -f "$HOME/.nia/shell.sh" ] && . "$HOME/.nia/shell.sh"
